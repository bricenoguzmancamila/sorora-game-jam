  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogoInternoInteractivo
  dialogo: {fileID: 1955400460}
  textoDialogo: {fileID: 194250111}
  textoNombre: {fileID: 131364301}
  personajes:
  - {fileID: 905131213}
  - {fileID: 861664557}
  lineas:
  - nombre: '???:'
    indicePersonaje: 1
    sprite: {fileID: 0}
    texto: Has pronunciado palabras que los vivos olvidaron.
  - nombre: 'Genesis:'
    indicePersonaje: 0
    sprite: {fileID: -16853467791702525, guid: fafecbf20ae1c7f4bb3e15278dd12738, type: 3}
    texto: "Por favor... devu\xE9lvemelos."
  - nombre: '???:'
    indicePersonaje: 1
    sprite: {fileID: 0}
    texto: No devuelvo. Intercambio.
  - nombre: 'Genesis:'
    indicePersonaje: 0
    sprite: {fileID: 0}
    texto: "No me importa lo que cueste. T\xF3malo de m\xED."
  - nombre: '???:'
    indicePersonaje: 1
    sprite: {fileID: 0}
    texto: "No tomar\xE9 tu vida. Tomar\xE9 aquello que te convierte en quien eres."
  - nombre: '???:'
    indicePersonaje: 1
    sprite: {fileID: 0}
    texto: 'Uno por uno... hasta que solo quede el espacio que dejaron sus nombres.

'
  - nombre: 'Genesis:'
    indicePersonaje: 0
    sprite: {fileID: 0}
    texto: ' ...acepto.

'
  - nombre: 
    indicePersonaje: 0
    sprite: {fileID: 0}
    texto: 
  - nombre: 
    indicePersonaje: 0
    sprite: {fileID: 0}
    texto: 
